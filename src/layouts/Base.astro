---
/**
 * Page shell for the holding site.
 *
 * Mirrors src/game/web/templates/website/base.html — same fonts,
 * same Bootstrap 4 base, same fcm-dark.css overlay — so this site
 * and the game site read as one brand.
 */
const {
  title = "Full Circle MUD",
  description = "An old-school text MUD with real on-chain item ownership on the XRP Ledger. Currently in pre-alpha.",
} = Astro.props;

const PLAY_URL = "https://staging.fcmud.world";
const DISCORD_URL = "https://discord.gg/j8b5GkysM3";
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="author" content="Full Circle MUD" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <meta property="og:site_name" content="Full Circle MUD" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://fcmud.world/og-preview.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://fcmud.world/og-preview.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css"
      integrity="sha384-B0vP5xmATw1+K9KRQjQERJvTumQW0nPEzvF6L/Z6nronJ3oUOFUFpCjEUQouq2+l"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/css/site.css" />
    <link rel="stylesheet" href="/css/fcm-dark.css" />

    <title>{title}</title>
  </head>

  <body>
    <nav class="navbar navbar-dark font-weight-bold navbar-expand-lg">
      <a class="navbar-brand" href="/">
        <div class="media">
          <img class="d-flex navbar-brand-logo mx-3" src="/fcm-logo.png" alt="Full Circle MUD logo" />
          <div class="media-body align-self-center">
            Full Circle MUD
          </div>
        </div>
      </a>

      <div class="ml-auto">
        <ul class="navbar-nav flex-row">
          <li><a class="nav-link px-3" href={DISCORD_URL} target="_blank" rel="noopener">Discord</a></li>
          <li><a class="nav-link px-3" href={PLAY_URL}>Play</a></li>
        </ul>
      </div>
    </nav>

    <div class="container main-content mt-4">
      <slot />
    </div>

    <footer class="footer">
      <div class="container">
        <div class="row justify-content-center">
          <span class="text-white">
            Powered by <a class="text-white font-weight-bold" href="https://evennia.com">Evennia.</a>
          </span>
        </div>
      </div>
    </footer>
  </body>
</html>
